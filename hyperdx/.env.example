# ==============================================================================
# HyperDX (Local Self-Hosted) Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

# Network & Host Binding
HYPERDX_LISTEN_IP=0.0.0.0
HYPERDX_CONNECT_IP=127.0.0.1
HYPERDX_UI_PORT=8088
HYPERDX_OTLP_HTTP_PORT=4318
HYPERDX_OTLP_GRPC_PORT=4317
HYPERDX_CLICKHOUSE_HTTP_PORT=8123
HYPERDX_CLICKHOUSE_TCP_PORT=9000

# Timezone (Docker Host PC Timezone)
TZ=Asia/Singapore

# Client Target URLs (Derived for external reference)
HYPERDX_SERVER_URL=http://${HYPERDX_CONNECT_IP}:${HYPERDX_UI_PORT}
HYPERDX_OTLP_ENDPOINT=http://${HYPERDX_CONNECT_IP}:${HYPERDX_OTLP_HTTP_PORT}
