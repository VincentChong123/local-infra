# ==============================================================================
# Langfuse v4 (Local Self-Hosted) Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# Generate secure random secrets for passwords/keys:
#   openssl rand -hex 32
# ==============================================================================

# Network & Host Binding
LANGFUSE_LISTEN_IP=0.0.0.0
LANGFUSE_CONNECT_IP=127.0.0.1
LANGFUSE_UI_PORT=3100

# Client Target URLs (Derived)
LANGFUSE_SERVER_URL=http://${LANGFUSE_CONNECT_IP}:${LANGFUSE_UI_PORT}
LANGFUSE_HOST="${LANGFUSE_SERVER_URL}"

# API Key Pair for Telemetry Ingestion (used by client applications and seed project)
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

# Headless Initial Seed Credentials (First start only)
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_DEV_PASSWORD

# Web UI & Session Encryption Secrets
LANGFUSE_NEXTAUTH_SECRET=CHANGEME_32_HEX_CHARS
LANGFUSE_SALT=CHANGEME_32_HEX_CHARS
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS

# Backend Database Passwords
LANGFUSE_POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD
LANGFUSE_MINIO_PASSWORD=CHANGEME_MINIO_PASSWORD
LANGFUSE_REDIS_AUTH=CHANGEME_REDIS_PASSWORD
