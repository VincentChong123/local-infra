# ==============================================================================
# Grafana (Local Self-Hosted) Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

GRAFANA_LISTEN_IP=0.0.0.0
GRAFANA_CONNECT_IP=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_USER_ID=1000:1000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_INSTALL_PLUGINS=grafana-clickhouse-datasource
